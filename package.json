{
  "name": "bb-plugin-homepage-dashboard",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "Homelab Live Dashboard",
    "description": "A homepage section and nav panel representing the FULL homelab estate — every entry from the runtime truth map (apps, services, remote nodes, infra, retired), grouped by category, with real HTTP health probes of what's publicly reachable and honest inventory for private/source-owned/retired routes. Refreshed on an interval and over realtime.",
    "branding": {
      "icon": "Activity"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@radix-ui/react-dialog": "^1.1.19"
  }
}
