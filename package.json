{
  "name": "bb-plugin-homepage-dashboard",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "Homelab Live Dashboard",
    "description": "A homepage section and nav panel showing the LIVE state of the homelab estate — real HTTP health probes of services, VMs, and remote nodes (OpenClaw, Basic Memory, Home Assistant, n8n, SearXNG, Kaneo, Gitea, Immich, blog), refreshed on an interval and over realtime.",
